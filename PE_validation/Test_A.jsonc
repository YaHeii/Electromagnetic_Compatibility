{
  "USV1": {
    "ID": "USV1",
    "Location": {
      "type": "Point_3D",
      "coordinates": [ 720, 0, 0 ] // 紧凑编队，舰间距约400m
    },
    "Speed": 15, // 突击高速，约30节
    "Orientation": 0,
    "Transmitter1": {
      "ID": "Device1",
      "type": "TRANSMITTER",
      "Gain": "20", // dBm
      "Location_Offset": [ 1, 0, 2 ],
      "Central_F": "1", // GHz，同频段无隔离
      "Bandwith": "100", // MHz
      "Power": "43", // dBm，满功率20W盲发（能域违规）
      "angle": "225", // 【高危优化】指向编队几何中心方向（USV4/USV6方向）
      "BeamWidth": "20", // angle
      "PolarizationMethod": "垂直极化",
      "AntennaType": "喇叭天线"
    },
    "Receiver1": {
      "ID": "Device2",
      "type": "RECEIVER",
      "Gain": "20", // dBm
      "Location_Offset": [ -1, 0, 2 ],
      "Central_F": "1", // GHz，同频段接收（频域违规）
      "Bandwith": "100", // MHz
      "Sensitivity": "85.0", // 极高灵敏度侦听节点 (-100 dBm)
      "interferenceMargin": "0", // 无带外抑制
      "SINRMargin": "0",
      "noiseFigure": "3"
    }
  },

