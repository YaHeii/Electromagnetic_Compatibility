{
  "USV1": {
    "ID": "USV1",
    "Location": {
      "type": "Point_3D",
      "coordinates": [ 2880, 0, 0 ] // 坐标放大4倍，舰间距约1600m（空域隔离）
    },
    "Speed": 6, // 巡航速度，约12节
    "Orientation": 0,
    "Transmitter1": {
      "ID": "Device1",
      "type": "TRANSMITTER",
      "Gain": "20", // dBm
      "Location_Offset": [ 1, 0, 2 ],
      "Central_F": "1", // GHz
      "Bandwith": "100", // MHz
      "Power": "30", // 【优化1】降功率：从43dBm(20W)降至30dBm(1W)，能域隔离
      "angle": "0", // 【优化2】波束管控：指向正东(X+)，远离编队中心
      "BeamWidth": "20", // angle
      "PolarizationMethod": "垂直极化",
      "AntennaType": "喇叭天线"
    },
    "Receiver1": {
      "ID": "Device2",
      "type": "RECEIVER",
      "Gain": "20", // dBm
      "Location_Offset": [ -1, 0, 2 ],
      "Central_F": "1", // 【合规优化】保持1GHz，通过interferenceMargin实现频域隔离
      "Bandwith": "100", // MHz
      "Sensitivity": "75.0",
      "interferenceMargin": "-60", // 【优化3】引入滤波器，等效60dB频段隔离度
      "SINRMargin": "0",
      "noiseFigure": "3"
    }
  },

