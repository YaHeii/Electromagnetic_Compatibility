{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electromagnetic-compatibility.local/schema/usv-environment.schema.json",
  "title": "USV Environment Input Schema",
  "description": "无人艇编队与环境输入标准格式",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "usvs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema 版本号"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "usvs": {
      "type": "array",
      "minItems": 1,
      "description": "无人艇列表",
      "items": {
        "$ref": "#/$defs/usv"
      }
    }
  },
  "$defs": {
    "point3D": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "Point3D",
          "description": "固定三维点类型"
        },
        "coordinates": {
          "type": "array",
          "description": "三维坐标，单位 m，顺序为 [x, y, z]",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "vector3": {
      "type": "array",
      "description": "三维偏移量，单位 m，顺序为 [x, y, z]",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRange",
        "ductHeight",
        "windSpeed",
        "dx",
        "dz",
        "nz",
        "angleStepDeg"
      ],
      "properties": {
        "maxRange": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "最大传播距离，单位 m"
        },
        "ductHeight": {
          "type": "number",
          "minimum": 0,
          "description": "蒸发波导高度，单位 m"
        },
        "windSpeed": {
          "type": "number",
          "minimum": 0,
          "description": "海面风速，单位 m/s"
        },
        "dx": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "水平方向步进，单位 m"
        },
        "dz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "垂直分辨率，单位 m"
        },
        "nz": {
          "type": "integer",
          "minimum": 1,
          "description": "垂直网格数量"
        },
        "angleStepDeg": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360,
          "description": "二维仿真的角度步进，单位 deg"
        }
      }
    },
    "transmitter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ID",
        "type",
        "gainDbi",
        "locationOffset",
        "centerFrequencyGHz",
        "bandwidthMHz",
        "powerDbm",
        "antennaPhiDeg",
        "beamWidthDeg",
        "polarization",
        "antennaType"
      ],
      "properties": {
        "ID": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "TRANSMITTER"
        },
        "gainDbi": {
          "type": "number",
          "description": "设备或天线增益，单位 dBi"
        },
        "locationOffset": {
          "$ref": "#/$defs/vector3"
        },
        "centerFrequencyGHz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "中心频率，单位 GHz"
        },
        "bandwidthMHz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "带宽，单位 MHz"
        },
        "powerDbm": {
          "type": "number",
          "description": "发射功率，单位 dBm"
        },
        "antennaPhiDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 180,
          "description": "相对正 z 轴向下倾斜的角度，单位 deg"
        },
        "beamWidthDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "波束宽度，单位 deg"
        },
        "polarization": {
          "type": "string",
          "enum": [
            "VERTICAL",
            "HORIZONTAL"
          ]
        },
        "antennaType": {
          "type": "string",
          "enum": [
            "OMNI",
            "DIRECTIONAL",
            "HORN",
            "SHAPED_BEAM",
            "REFLECTOR"
          ]
        }
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ID",
        "type",
        "gainDbi",
        "locationOffset",
        "centerFrequencyGHz",
        "bandwidthMHz",
        "sensitivityDbm",
        "interferenceMarginDb",
        "sinrMarginDb",
        "noiseFigureDb"
      ],
      "properties": {
        "ID": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "RECEIVER"
        },
        "gainDbi": {
          "type": "number",
          "description": "设备或天线增益，单位 dBi"
        },
        "locationOffset": {
          "$ref": "#/$defs/vector3"
        },
        "centerFrequencyGHz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "中心频率，单位 GHz"
        },
        "bandwidthMHz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "带宽，单位 MHz"
        },
        "sensitivityDbm": {
          "type": "number",
          "exclusiveMaximum": 0,
          "description": "接收机灵敏度，单位 dBm，必须为负值"
        },
        "interferenceMarginDb": {
          "type": "number",
          "description": "干扰容限或等效带外抑制，单位 dB"
        },
        "sinrMarginDb": {
          "type": "number",
          "description": "SINR 裕量，单位 dB"
        },
        "noiseFigureDb": {
          "type": "number",
          "minimum": 0,
          "description": "噪声系数，单位 dB"
        }
      }
    },
    "usv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ID",
        "location",
        "speed",
        "shipOrientationDeg",
        "transmitters",
        "receivers"
      ],
      "properties": {
        "ID": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/point3D"
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "description": "船速，单位 m/s"
        },
        "shipOrientationDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "船在二维平面的朝向角，单位 deg"
        },
        "transmitters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transmitter"
          }
        },
        "receivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receiver"
          }
        }
      }
    }
  }
}
